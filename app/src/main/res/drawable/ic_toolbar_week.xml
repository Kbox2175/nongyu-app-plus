    <path
        android:pathData="M4.8,6.72 L19.2,6.72 M4.8,12 L19.2,12 M4.8,17.28 L19.2,17.28"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.64"
        android:strokeLineCap="round" />
</vector>
